# Contoh environment Render. Masukkan melalui Environment Variables di Render.
# .env.example tidak dimuat otomatis oleh backend Python.
PORT=10000
BAYLAB_SECURE_COOKIES=true
BAYLAB_ALLOWED_ORIGINS=https://side-quest-uts.vercel.app
BAYLAB_DATA_DIR=/app/data
BAYLAB_DB=/app/data/workspace.sqlite3
BAYLAB_RAG_DB=/app/data/rag.sqlite3

# Render Free: filesystem sementara. Jangan simpan data riset nyata di sini.
# Backend Python belum memakai akun/database Supabase.
# Ollama tidak otomatis terpasang oleh Dockerfile ini.
