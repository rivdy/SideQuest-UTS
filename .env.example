# Local development only. Replace this placeholder before starting Compose.
POSTGRES_DB=baylab
POSTGRES_USER=baylab
POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# Optional local RAG settings (export in the backend terminal; .env is not auto-loaded)
BAYLAB_OLLAMA_MODEL=qwen3:4b
# BAYLAB_RAG_DB=D:/path/to/private/rag.sqlite3

# Workspace lokal: ekspor di terminal backend; file .env tidak otomatis dibaca.
# BAYLAB_DATA_DIR=D:/private/baylab
# BAYLAB_DB=D:/private/baylab/workspace.sqlite3
# BAYLAB_SECURE_COOKIES=true # hanya saat frontend menggunakan HTTPS
# BAYLAB_ALLOWED_ORIGINS=https://your-approved-origin.example
# BAYLAB_SOLUBILITY_FILE=D:/datasets/aqueous-solubility.csv
