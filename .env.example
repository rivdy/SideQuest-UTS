# Contoh konfigurasi pengembangan lokal; bukan file untuk menyimpan rahasia.
# Docker Compose membaca .env setelah file ini disalin dan password diganti.
POSTGRES_DB=baylab
POSTGRES_USER=baylab
POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# Backend Python membaca environment proses, bukan .env secara otomatis.
BAYLAB_OLLAMA_MODEL=qwen3:4b
# BAYLAB_DATA_DIR=D:/private/baylab
# BAYLAB_DB=D:/private/baylab/workspace.sqlite3
# BAYLAB_RAG_DB=D:/private/baylab/rag.sqlite3
# BAYLAB_SOLUBILITY_FILE=D:/datasets/aqueous-solubility.csv

# Vercel / Supabase: gunakan frontend/.env.example.
# Render / Python: gunakan backend/.env.example.
# Jangan masukkan password asli, Secret Key, atau service_role ke file contoh.
