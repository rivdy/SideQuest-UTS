# Salin ke frontend/.env.local untuk lokal (file ini diabaikan Git).
# Di Vercel, tambahkan nilai yang sama melalui Settings > Environment Variables.
# Mode local memakai backend Python; mode supabase memakai login cloud.
BAYLAB_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://nehmhhjhwsyxhfrpkfxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
BAYLAB_ALLOWED_ORIGINS=https://side-quest-uts.vercel.app

# Integrasi ini tidak membutuhkan Secret Key atau service_role.
# .env.example hanya template; Vercel tidak otomatis memuat file ini.
